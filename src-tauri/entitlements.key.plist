<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for Mac App Store submission (ROADMAP.md 阶段 3, 1.4). Only the
	     key edition uses this — the login edition ships outside the App Store
	     via Developer ID and has no sandbox restrictions.

	     Start minimal: these are the only capabilities the app actually
	     needs. Add more only if a real sandboxed run surfaces something this
	     list is missing — App Sandbox failures are usually loud and specific
	     (a denied syscall in Console.app), not silent, so it should be
	     straightforward to tell what's missing if something breaks. -->

	<!-- The sandbox itself. Mandatory for App Store distribution — without
	     this, none of the other entitlements below do anything. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Outbound HTTP to Zhihu's Data Open Platform (developer.zhihu.com) —
	     see src/source/key.ts. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- The sidecar binds 127.0.0.1:4318 to serve its local HTTP API to the
	     webview frontend (src/server.ts's listen()). Verified empirically,
	     not assumed: a real sandboxed run without this denied the bind
	     outright (`Sandbox: zhidang-server deny(1) network-bind
	     local:*:4318`) even though the socket never leaves the machine —
	     loopback-only listening still counts as "network access" to the
	     sandbox, contrary to what you'd guess. The sidecar itself declares
	     no entitlements of its own beyond app-sandbox+inherit (see
	     entitlements.key.child.plist) — it gets this via inheritance from
	     here. -->
	<key>com.apple.security.network.server</key>
	<true/>

	<!-- Read/write for whatever directory the user picks via the "浏览…"
	     save-location dialog (src-tauri/src/lib.rs's dialog:allow-open
	     permission) and everything the exporter subsequently writes under
	     it (answers/, articles/, images/, index.json, export-report.json). -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
