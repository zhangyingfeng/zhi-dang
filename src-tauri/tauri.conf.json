{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "知档",
  "version": "1.0.0-preview.6",
  "identifier": "com.zhangyingfeng.zhidang",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://127.0.0.1:4317",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:sidecar"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {"../public": "public"},
    "externalBin": ["binaries/zhidang-server"],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
