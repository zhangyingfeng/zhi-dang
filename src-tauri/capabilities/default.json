{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the app's own main window",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": ["http://127.0.0.1:4317/*"]
  },
  "permissions": [
    "core:default",
    "allow-open-login-window",
    "allow-zhihu-fetch",
    "allow-zhihu-me",
    "allow-wait-for-login",
    "allow-resize-main-window",
    "allow-logout",
    "allow-check-login-status",
    "allow-save-access-secret",
    "allow-has-access-secret",
    "allow-get-access-secret",
    "allow-clear-access-secret",
    "dialog:allow-open",
    "dialog:allow-message",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify"
  ]
}
