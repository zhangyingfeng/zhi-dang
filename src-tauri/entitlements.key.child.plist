<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Entitlements for the zhidang-server sidecar specifically — NOT the
	     same file as entitlements.key.plist (the main app's). Per Apple's
	     App Sandbox docs: a child process that should inherit its parent's
	     sandbox must carry ONLY these two keys — app-sandbox and inherit.
	     Any other App Sandbox entitlement on the child (e.g. the network/
	     file-access keys the main app declares) makes the OS treat it as
	     trying to start its own independent sandbox container instead of
	     inheriting the parent's, which a bare compiled binary (not a proper
	     .app bundle) can't do — that's what crashed at libsecinit_appsandbox.
	     The child gets the parent's already-granted network/file access for
	     free via inherit; it doesn't declare its own copies of those. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.inherit</key>
	<true/>
</dict>
</plist>
