{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "知档",
  "version": "0.1.0",
  "identifier": "com.zhangyingfeng.zhidang",
  "build": {
    "frontendDist": "../dist/public",
    "devUrl": "http://127.0.0.1:4317",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "知档",
        "width": 900,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
