{
  "name": "zhi-dang",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.login.ts",
    "dev:key": "tsx src/index.key.ts",
    "build": "tsc -p tsconfig.json && cp -R public dist/public",
    "start": "node dist/src/index.login.js",
    "start:key": "node dist/src/index.key.js",
    "test": "node scripts/check-dom-refs.mjs && tsx --test test/*.test.ts",
    "build:sidecar": "./scripts/build-sidecar.sh login",
    "build:sidecar:login": "./scripts/build-sidecar.sh login",
    "build:sidecar:key": "./scripts/build-sidecar.sh key",
    "tauri": "tauri",
    "tauri:key": "tauri build --config src-tauri/tauri.key.conf.json -f key",
    "tauri:key:dev": "tauri dev --config src-tauri/tauri.key.conf.json -f key"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "express": "^5.1.0",
    "turndown": "^7.2.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/express": "^5.0.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/turndown": "^5.0.5",
    "jsdom": "^30.0.1",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
