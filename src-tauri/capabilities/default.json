{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the app's own main window",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": ["http://127.0.0.1:4317/*"]
  },
  "permissions": [
    "core:default",
    "allow-open-login-window",
    "allow-zhihu-fetch",
    "allow-zhihu-me",
    "allow-wait-for-login",
    "allow-resize-main-window",
    "allow-logout",
    "allow-check-login-status",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir"
  ]
}
